{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "nixonmade",
  "account_id": "f90a11b318e5ebe6d6a3256d3c3566de",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "preview_urls": true,
  // Query strings on /thanks and /api/file carry the checkout session and the
  // signed file token. Redact them from Workers logs and traces. Logs are not
  // persisted, so this does not turn on a log-storage product.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "persist": false
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "nixonmade.com", "custom_domain": true },
    { "pattern": "www.nixonmade.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [{ "name": "PURCHASE_GATE", "class_name": "PurchaseGate" }]
  },
  "migrations": [
    {
      "tag": "v1-purchase-gate",
      "new_sqlite_classes": ["PurchaseGate"]
    }
  ],
  // Private bucket. Do not enable r2.dev or a public custom domain.
  "r2_buckets": [{ "binding": "DOWNLOADS", "bucket_name": "nixonmade-downloads" }],
  // Secrets (wrangler secret put), never commit these:
  //   STRIPE_RESTRICTED_KEY, DOWNLOAD_SIGNING_SECRET, STRIPE_WEBHOOK_SECRET
  // Product link and price ids are allowlist config. Leave them empty until
  // the Stripe Dashboard ids exist. Test ids and live ids are separate.
  // Ship Kit's kit and done-for-you Payment Links both go in the ship-kit
  // lists when they should deliver the same zip.
  "vars": {
    "DOWNLOAD_LIMIT": "5",
    "DOWNLOAD_TTL_SECONDS": "900",
    "RATE_LIMIT_IP_PER_MINUTE": "60",
    "RATE_LIMIT_SESSION_PER_MINUTE": "20",
    // Checkout Session reads. The per-IP cap is spent before the shared cap,
    // so one connection cannot empty the worker-wide budget of 300/min.
    "RATE_LIMIT_STRIPE_IP_PER_MINUTE": "10",
    "RATE_LIMIT_STRIPE_PER_MINUTE": "300",
    "PRODUCT_FIELD_KIT_TEST_LINKS": "plink_1UVfCn9YvevV3dxlI1EAEamw",
    "PRODUCT_FIELD_KIT_TEST_PRICES": "price_1UVfB19YvevV3dxlEIDjHeqA",
    "PRODUCT_FIELD_KIT_LIVE_LINKS": "",
    "PRODUCT_FIELD_KIT_LIVE_PRICES": "",
    "PRODUCT_FIELD_KIT_KEY": "products/field-kit.zip",
    "PRODUCT_FIELD_KIT_FILENAME": "nixonmade-field-kit.zip",
    "PRODUCT_FIELD_KIT_TITLE": "Field Kit",
    "PRODUCT_SHIP_KIT_TEST_LINKS": "plink_1UVfEU9YvevV3dxlDUOL2JRO",
    "PRODUCT_SHIP_KIT_TEST_PRICES": "price_1UVfBZ9YvevV3dxlvtDF8mFn",
    "PRODUCT_SHIP_KIT_LIVE_LINKS": "",
    "PRODUCT_SHIP_KIT_LIVE_PRICES": "",
    "PRODUCT_SHIP_KIT_KEY": "products/ship-kit.zip",
    "PRODUCT_SHIP_KIT_FILENAME": "nixonmade-ship-kit.zip",
    "PRODUCT_SHIP_KIT_TITLE": "Ship Kit",
    "PRODUCT_FLEET_SHEETS_TEST_LINKS": "plink_1UVfEr9YvevV3dxlpJxulJSC",
    "PRODUCT_FLEET_SHEETS_TEST_PRICES": "price_1UVfCg9YvevV3dxlnfp5voyQ",
    // Fleet Sheets is the only product on sale. Field Kit and Ship Kit live
    // lists stay empty, so a live session for those products fails closed.
    // R2 object FleetSheets-v1.1.0-macOS.dmg
    // sha256 dedc5d0dbd8757a325290ae487ccd8f3da3ad66cbb9c7ebb54b45540dc17c41e
    // 13225040 bytes
    "PRODUCT_FLEET_SHEETS_LIVE_LINKS": "plink_1UVcxz9YvevV3dxlEFkHsQlc",
    "PRODUCT_FLEET_SHEETS_LIVE_PRICES": "price_1UVcxv9YvevV3dxllPPANBuz",
    "PRODUCT_FLEET_SHEETS_KEY": "FleetSheets-v1.1.0-macOS.dmg",
    "PRODUCT_FLEET_SHEETS_FILENAME": "nixonmade-fleet-sheets.dmg",
    "PRODUCT_FLEET_SHEETS_TITLE": "Fleet Sheets",
    // Toolwarden is not on sale. Empty id lists match no checkout session, so
    // nothing is issued. Fill the four lists, upload the pkg under KEY, then
    // add the buy anchor to the page.
    "PRODUCT_TOOLWARDEN_TEST_LINKS": "",
    "PRODUCT_TOOLWARDEN_TEST_PRICES": "",
    "PRODUCT_TOOLWARDEN_LIVE_LINKS": "",
    "PRODUCT_TOOLWARDEN_LIVE_PRICES": "",
    "PRODUCT_TOOLWARDEN_KEY": "Toolwarden-0.2.0.pkg",
    "PRODUCT_TOOLWARDEN_FILENAME": "toolwarden-0.2.0.pkg",
    "PRODUCT_TOOLWARDEN_TITLE": "Toolwarden",
    // Stickler is free: no Stripe ids, never matched by a checkout session.
    // KEY is empty so /stickler/download answers 503 until the file is
    // uploaded to R2 under the `stickler/` prefix (e.g. stickler/Stickler.dmg).
    "PRODUCT_STICKLER_KEY": "",
    "PRODUCT_STICKLER_FILENAME": "Stickler.dmg",
    "PRODUCT_STICKLER_TITLE": "Stickler",
    "RATE_LIMIT_FREE_IP_PER_HOUR": "10",
    "RATE_LIMIT_FREE_PER_DAY": "2000",
    // Sparkle feed. Joe uploads `stickler/appcast.xml` and `stickler/updates/*`
    // to the DOWNLOADS bucket himself; the worker only serves those bytes and
    // never holds a signing key. The appcast has its own looser per-IP limit,
    // update archives their own per-IP and worker-wide daily limits.
    "RATE_LIMIT_APPCAST_IP_PER_HOUR": "120",
    "RATE_LIMIT_UPDATES_IP_PER_HOUR": "20",
    "RATE_LIMIT_UPDATES_PER_DAY": "5000",
    // Support: Stripe Payment Link code (buy.stripe.com/<code>) or full URL.
    // Empty means /stickler/support/<amount> answers 503 "not set up yet".
    "STICKLER_SUPPORT_LINK_5": "",
    "STICKLER_SUPPORT_LINK_10": "",
    "STICKLER_SUPPORT_LINK_20": "",
    "STICKLER_SUPPORT_LINK_OTHER": ""
  }
}
